{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "moj/components/date-picker/macro.njk" import mojDatePicker %}
{% from "partials/hiddenInputs/macro.njk" import hiddenInputs %}
{% from "partials/simplePagination/macro.njk" import simplePagination %}
{% from "partials/cardTable/macro.njk" import cardTable %}

{% set fullScreen = true %}
{% set fullWidth = true %}
{% set pageTitle = 'Search for a prisoner - View and manage court appearances' %}

{% if not hasValidationError %}
  {% set searchResultCount = paginationParams.totalRows %}
{% endif %}

{% block meta %}
  <meta name="autocompleteElements" content="court"/>
  <meta name="autocompleteElements" content="reason"/>
{% endblock %}

{% block innerContent %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">View and manage court appearances</span>
        <label for="searchTerm"><h1 class="govuk-heading-l">Search for a prisoner</h1></label>
      </div>
    </div>
  </div>

  <div class="block-background govuk-!-padding-top-6 govuk-!-padding-bottom-6 govuk-!-margin-bottom-7 govuk-!-display-none-print">
    <div class="govuk-width-container">
      <div class="moj-search govuk-!-width-two-thirds">
        <form method="GET">
          {{ hiddenInputs(query | getQueryEntries(['start','end','court','reason','type','size','history'])) }}
          {{ govukInput({
            name: 'searchTerm',
            classes: "moj-search__input",
            hint: {
              text: "Enter name or prison number."
            },
            value: searchTerm,
            errorMessage: validationErrors | findError('searchTerm')
          }) }}

          {{ govukButton({
            classes: "moj-search__button",
            text: "Search",
            preventDoubleClick: true
          }) }}
        </form>
      </div>
    </div>
  </div>

  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter govuk-!-display-none-print">
        <section role="region" aria-label="Search Filters">
          <form class="hmpps-side-filter" method="GET">
            {{ hiddenInputs(query | getQueryEntries(['searchTerm','size', 'history'])) }}
            <h2 class="hmpps-side-filter__header">Filter</h2>

            {{ govukButton({
              text: "Apply",
              preventDoubleClick: true
            }) }}

            <div class="hmpps-side-filter__content">
              {{ mojDatePicker({
                id: "start",
                name: "start",
                label: {
                  text: 'Date from'
                },
                hint: { text: 'For example, 17/5/2024.' },
                value: start,
                errorMessage: validationErrors | findError('start'),
                classes: 'hmpps-datepicker--fixed-width'
              }) }}

              {{ mojDatePicker({
                id: "end",
                name: "end",
                label: {
                  text: 'Date to'
                },
                hint: { text: 'For example, 17/5/2024.' },
                value: end,
                errorMessage: validationErrors | findError('end'),
                classes: 'hmpps-datepicker--fixed-width'
              }) }}

              {{ govukSelect({
                id: "court",
                name: "court",
                label: { text: "Court location", classes: "govuk-label--m" },
                hint: { text: "For example, London" },
                items: courts | fromCodedDescription | addSelectValue('') | setSelectedValue(court),
                errorMessage: validationErrors | findError('court')
              }) }}

              {{ govukSelect({
                id: "reason",
                name: "reason",
                label: { text: "Reason", classes: "govuk-label--m" },
                hint: { text: "For example, Court appearance" },
                items: reasons | fromCodedDescription | addSelectValue('') | setSelectedValue(reason),
                errorMessage: validationErrors | findError('reason')
              }) }}

              {{ govukCheckboxes({
                id: "type",
                name: "type",
                fieldset: {
                  legend: {
                    text: "Appearance type",
                    classes: "govuk-fieldset__legend--m"
                  }
                },
                classes: "govuk-checkboxes--small",
                errorMessage: validationErrors | findError('type'),
                items: [
                  {
                    value: 'IN_PERSON',
                    text: "In person"
                  },
                  {
                    value: 'VIDEO_LINK',
                    text: "Video link"
                  }
                ] | setCheckedValue(type or '')
              }) }}
            </div>
          </form>
        </section>
      </div>

      <div class="govuk-grid-column-three-quarters print-full-width">
        {% if hasValidationError %}
          <p class="govuk-!-margin-bottom-6"><strong>Enter a valid filter to search and view court appearances.</strong></p>
        {% elseif not results.length %}
          <p class="govuk-!-margin-bottom-6"><strong>No court appearances match your search.</strong></p>
        {% else %}
          <div class="govuk-!-display-none-print govuk-!-margin-bottom-5 govuk-grid-row">
            <div class="govuk-grid-column-one-third">
              <form id="sortForm">
                {{ hiddenInputs(query | getQueryEntries(['searchTerm','start','end','court','reason','type','size','history'])) }}
                <label class="govuk-label" for="sort">Sort by</label>
                <select class="govuk-select hmpps-sort-selector__select" id="sort" name="sort" value="{{ sort or 'start,asc' }}">
                  <option value="start,asc" {{ 'selected' if sort === 'start,asc' else '' }}>Start date (oldest)</option>
                  <option value="start,desc" {{ 'selected' if sort === 'start,desc' else '' }}>Start date (most recent)</option>
                </select>
                <button type="submit" data-prevent-double-click="true" class="govuk-button hmpps-sort-selector__sort-button">
                  Sort
                </button>
              </form>
            </div>

            <div class="govuk-grid-column-one-third">
              <form id="sizeForm">
                {{ hiddenInputs(query | getQueryEntries(['searchTerm','start','end','court','reason','type','sort','history'])) }}
                <label class="govuk-label" for="sort">Show results</label>
                <select class="govuk-select hmpps-sort-selector__select" id="size" name="size" value="{{ size }}">
                  <option value="10" {{ 'selected' if size == '10' }}>10 per page</option>
                  <option value="25" {{ 'selected' if size == '25' }}>25 page</option>
                  <option value="50" {{ 'selected' if size == '50' }}>50 per page</option>
                  <option value="100" {{ 'selected' if size == '100' }}>100 per page</option>
                </select>
                <button type="submit" data-prevent-double-click="true" class="govuk-button hmpps-sort-selector__sort-button">
                  Sort
                </button>
              </form>
            </div>

            <div id="print-options" class="govuk-!-display-none govuk-grid-column-one-third govuk-!-padding-top-5">
              <div class="float-right">
                <svg width="19" height="21" viewBox="0 0 19 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M14.6005 11.4603C14.6005 11.2835 14.7433 11.1402 14.9193 11.1402H15.5569C15.7329 11.1402 15.8757 11.2835 15.8757 11.4603V12.1006C15.8757 12.2774 15.7329 12.4207 15.5569 12.4207H14.9193C14.7433 12.4207 14.6005 12.2774 14.6005 12.1006V11.4603Z" fill="black"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.23601 0C9.55725 2.56085e-05 9.86558 0.128274 10.0927 0.356377L13.5446 3.82262C13.7717 4.05072 13.8994 4.36034 13.8995 4.68292V8.32297H17.1508C18.1719 8.32297 19 9.15448 19 10.1799V15.3017C19 16.3271 18.1719 17.1586 17.1508 17.1586H13.8995V19.7833C13.8995 20.4551 13.3569 21 12.6878 21H6.31216C5.64314 21 5.10054 20.4551 5.10054 19.7833V17.1586H1.84919C0.82805 17.1586 2.05351e-08 16.3271 0 15.3017V10.1799C8.21417e-08 9.15448 0.82805 8.32297 1.84919 8.32297H5.10054V1.21668C5.10054 0.544866 5.64314 4.12395e-08 6.31216 0H9.23601ZM6.24866 19.7833C6.24866 19.8187 6.27695 19.8471 6.31216 19.8471H12.6878C12.723 19.8471 12.7513 19.8187 12.7513 19.7833V14.5977H6.24866V19.7833ZM1.84919 9.47588C1.46186 9.47588 1.14812 9.79094 1.14812 10.1799V15.3017C1.14812 15.6907 1.46186 16.0057 1.84919 16.0057H5.10054V13.4448H13.8995V16.0057H17.1508C17.5381 16.0057 17.8519 15.6907 17.8519 15.3017V10.1799C17.8519 9.79094 17.5381 9.47588 17.1508 9.47588H1.84919ZM6.31216 1.15291C6.27695 1.15291 6.24866 1.18133 6.24866 1.21668V8.32297H12.7513V4.99428H10.1376C9.46854 4.99428 8.92594 4.44942 8.92594 3.7776V1.15291H6.31216ZM10.0741 3.7776C10.0741 3.81296 10.1024 3.84137 10.1376 3.84137H11.9394L10.0741 1.9682V3.7776Z" fill="black"/>
                  <path d="M12.0503 15.4618V16.4221H6.94973V15.4618H12.0503Z" fill="black"/>
                  <path d="M12.0503 17.3825V18.3428H6.94973V17.3825H12.0503Z" fill="black"/>
                </svg>
                <a id="print-options-button" class="govuk-link govuk-link--no-visited-state" href="#">Print results</a>
              </div>
            </div>
          </div>

          {{ simplePagination(paginationParams) }}

          {% set rows = [] %}
          {% for result in results %}
            {% set rows = (rows.push(
              {
                title: { text: result.person | firstNameSpaceLastName + ' - ' + result.person.personIdentifier },
                action: { classes: 'govuk-!-display-none-print', text: 'View details', href: '/court-appearances/' + result.id },
                data: [
                  result.court.name,
                  result.start | formatDate("d MMMM yyyy"),
                  result.start | formatDate("HH:mm"),
                  result.reason.description
                ]
              }
            ), rows) %}
          {% endfor %}

          {{ cardTable({
            columns: [
              { text: 'Court location', width: 35 },
              { text: 'Date', width: 20 },
              { text: 'Time', width: 15 },
              { text: 'Reason', width: 30 }
            ],
            rows: rows
          }) }}

          {{ simplePagination(paginationParams) }}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}

{% block pageScripts %}
  <script type="text/javascript" nonce="{{ cspNonce }}">
    window.onload = function () {
      const printOptions = document.getElementById('print-options');
      if (printOptions) {
        printOptions.classList.remove('govuk-!-display-none')
      }

      document.getElementById('print-options-button').onclick = e => {
        e.preventDefault()
        e.stopPropagation()
        print()
      }
    }
  </script>
{% endblock %}
